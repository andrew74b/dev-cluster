REDIS_URL=redis://redis.outline.svc:6379

URL=https://outline.pandathedog.com
PORT=3000

FILE_STORAGE=s3
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

AWS_REGION=us-east-1
AWS_S3_ACCELERATE_URL=
AWS_S3_UPLOAD_BUCKET_URL=https://s3.pandathedog.com
AWS_S3_UPLOAD_BUCKET_NAME=outline
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_ACL=private

# Authentication
OIDC_AUTH_URI=https://auth.pandathedog.com/realms/internal/protocol/openid-connect/auth
OIDC_TOKEN_URI=https://auth.pandathedog.com/realms/internal/protocol/openid-connect/token
OIDC_USERINFO_URI=https://auth.pandathedog.com/realms/internal/protocol/openid-connect/userinfo
OIDC_LOGOUT_URI=https://auth.pandathedog.com/realms/internal/protocol/openid-connect/logout
OIDC_USERNAME_CLAIM=preferred_username
OIDC_DISPLAY_NAME=OpenID Connect
OIDC_SCOPES=openid profile email

ENABLE_UPDATES=0

DEBUG=

LOG_LEVEL=debug

SMTP_HOST=
SMTP_PORT=
SMTP_FROM_EMAIL=Outline <no-reply@outline.pandathedog.com>
SMTP_REPLY_EMAIL=Outline <no-reply@outline.pandathedog.com>
SMTP_TLS_CIPHERS=TLSv1.2
SMTP_SECURE=false

DEFAULT_LANGUAGE=en_US

RATE_LIMITER_ENABLED=true
